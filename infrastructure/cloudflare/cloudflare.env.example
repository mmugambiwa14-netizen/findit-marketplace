# Authentication used only by provisioning/deployment automation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Environment identity.
PEEKALISTING_ENV=staging
PEEKALISTING_MEDIA_DELIVERY_HOST=media-staging.example.com

# Worker secrets. Configure with `wrangler secret put`; do not commit values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
MEDIA_SIGNING_SECRET=

# Turnstile must use separate widgets per environment.
TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_ORIGINS=https://staging.example.com
TURNSTILE_ALLOWED_HOSTNAMES=staging.example.com

# Existing media processor compatibility names. Keep until the processor runner
# is migrated in a dedicated, backwards-compatible naming change.
FINDIT_SUPABASE_URL=
FINDIT_SUPABASE_SECRET_KEY=
FINDIT_EXPECTED_PROJECT_REF=
FINDIT_TOUR_PROCESSOR_BATCH_SIZE=5
PEEKALISTING_WORKER_POLL_SECONDS=5
