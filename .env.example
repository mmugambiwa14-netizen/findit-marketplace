# .env.example
# Copy to .env for local development. Never commit the real .env file.

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Authentication providers ---
# Enable only after the provider is configured for the exact deployment origin
# and the complete callback, cancellation and recovery flow has passed.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false

# --- Required marketplace capabilities ---
VITE_FEATURE_BUSINESS_PROFILES=true
VITE_FEATURE_MESSAGING=true
VITE_FEATURE_ESSENTIAL_NOTIFICATIONS=true
VITE_FEATURE_GOOGLE_OAUTH=false
VITE_FEATURE_MANUAL_LOCATION=true
VITE_FEATURE_REPORTING=true

# --- Maps and device location ---
# Production uses MapLibre GL JS with MapTiler Cloud. Create a protected
# MapTiler browser key restricted to the deployment origins before enabling.
VITE_FEATURE_MAPS=false
VITE_FEATURE_CURRENT_LOCATION=false
VITE_MAPTILER_PUBLIC_KEY=
VITE_MAPTILER_STYLE_ID=streets-v4

# --- Fail-closed capabilities not yet part of the Zimbabwe-first V1 contract ---
VITE_FEATURE_CURRENCY_CONVERSION=false
VITE_FEATURE_PHONE_VERIFICATION=false
VITE_FEATURE_INTERNATIONAL_LISTING=false
VITE_FEATURE_SERVICE_RADIUS=false
VITE_FEATURE_LISTING_EXPIRY=false
VITE_FEATURE_LISTING_FRESHNESS_REMINDERS=false

# Peek uses the first-party FFmpeg worker for the production target. Keep the
# browser flag off until hosted media lifecycle acceptance is complete.
VITE_FEATURE_TOURS=false
VITE_FEATURE_TOURS_PREVIEW=false
VITE_FEATURE_PREVIEW_FIXTURES=false
# Development-only. Auth bypass also requires Vite DEV mode, Peek preview, and
# a private/local Supabase hostname. Production validation rejects this flag.
VITE_PREVIEW_AUTH_BYPASS=false

# Server activation is independent from browser flags. These values are read
# only by deployment validation and backend workers; never prefix them with VITE_.
TOURS_BACKEND_ENABLED=false
FINDIT_TOURS_WORKERS_ENABLED=false
FINDIT_TOUR_PROCESSOR_MODE=github-actions
FINDIT_TOURS_RELEASE_ACCEPTED=false
FINDIT_ESSENTIAL_NOTIFICATIONS_WORKERS_ENABLED=false
FINDIT_RECOMMENDATION_WORKERS_ENABLED=false
FINDIT_TOURS_ACCEPTANCE_ID=

# Deferred/Future capabilities. These remain false for V1.
VITE_FEATURE_PAYMENTS=false
VITE_FEATURE_SUBSCRIPTIONS=false
VITE_FEATURE_ESCROW=false
VITE_FEATURE_PREMIUM_LISTINGS=false
VITE_FEATURE_AI_MODERATION=false
VITE_FEATURE_AI_BAN_EVASION=false
VITE_FEATURE_AI_TICKET_TRIAGE=false
VITE_FEATURE_AI_SUPPORT_CHAT=false
VITE_FEATURE_SCHEDULED_REMINDERS=false
VITE_FEATURE_MARKETING_EMAILS=false

# Server-only Supabase Edge Function secrets do not belong in this browser
# template. See docs/ENVIRONMENT_VARIABLES.md for placement and rotation rules.
# FINDIT_ALLOWED_ORIGINS=https://findit.example,https://www.findit.example
# FINDIT_REQUEST_BUDGET_SALT=replace-with-random-salt
# FINDIT_RECOMMENDATION_HEALTH_SECRET=replace-with-random-secret
# FINDIT_CONTEXTUAL_HEALTH_SECRET=replace-with-random-secret

# Custom SMTP for auth email (confirmation, recovery, email-change, security).
# Applied to the HOSTED project only -- via the Supabase dashboard, or by
# `supabase config push` from an environment where these are set. Never set
# locally: the local stack uses Mailpit, which the auth smoke test reads. See
# docs/SMTP_SETUP.md. FINDIT_SMTP_PASS is a provider API key/password -- keep it
# in the deploy secret store, never in a committed file.
# FINDIT_SMTP_HOST=smtp.your-provider.example
# FINDIT_SMTP_USER=apikey
# FINDIT_SMTP_PASS=replace-with-provider-api-key
# FINDIT_SMTP_ADMIN_EMAIL=no-reply@your-domain.example
# FINDIT_SMTP_SENDER_NAME=FindIt
# FINDIT_EXPECT_CUSTOM_SMTP=true   # production Auth preflight asserts SMTP is set
# FINDIT_RECOMMENDATION_WORKER_SECRET=replace-with-random-secret
# FINDIT_TOUR_CLEANUP_WORKER_SECRET=replace-with-random-secret
# FINDIT_TOUR_CACHE_WORKER_SECRET=replace-with-random-secret
# FINDIT_TOUR_OBSERVABILITY_WORKER_SECRET=replace-with-random-secret
# FINDIT_NOTIFICATION_FANOUT_WORKER_SECRET=replace-with-random-secret
# External processor mode only:
# FINDIT_TOUR_PROCESSING_WORKER_SECRET=replace-with-random-secret
# TOUR_PROCESSOR_URL=https://processor.example/jobs
# TOUR_PROCESSOR_SECRET=replace-with-shared-hmac-secret
# TOUR_PROCESSING_CALLBACK_URL=https://project-ref.supabase.co/functions/v1/tour-processing-callback
# TOUR_CACHE_PURGE_URL=https://cdn.example/purge
# TOUR_CACHE_PURGE_SECRET=replace-with-random-secret
